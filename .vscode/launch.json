    "version": "0.2.0",
    "configurations": [
        {
            "name": "Launch SharpDbg",
            "type": "sharpdbg",
            "request": "launch",
            "program": "${workspaceFolder}/bin/Debug/net10.0/YourApp.dll",
            "cwd": "${workspaceFolder}",
            "stopAtEntry": false
        },
        {
            "name": "Attach to Process",
            "type": "sharpdbg",
            "request": "attach",
            "processId": "^\"\\${command:pickProcess}\""
        },
        {
            "name": "Launch SharpDbg",
            "type": "sharpdbg",
            "request": "launch",
            "program": "${workspaceFolder}/bin/Debug/net10.0/YourApp.dll",
            "cwd": "${workspaceFolder}",
            "stopAtEntry": false
        },
        {
            "name": "Attach to Process",
            "type": "sharpdbg",
            "request": "attach",
            "processId": "${command:pickProcess}"
        }
    ]
}